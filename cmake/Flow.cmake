# Experimental optical-flow extraction; independent of F05/F06.
add_library(saccade_flow_records src/flow_records.cpp)
target_include_directories(saccade_flow_records PUBLIC include)
add_executable(flow_records_tests tests/flow_records_tests.cpp)
target_link_libraries(flow_records_tests PRIVATE saccade_flow_records)
if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
  foreach(target saccade_flow_records flow_records_tests)
    target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Werror -ffp-contract=off)
  endforeach()
endif()
add_test(NAME flow_records COMMAND flow_records_tests ${CMAKE_CURRENT_BINARY_DIR}/flow-test.scfl)

add_library(saccade_gmc_flow src/gmc_flow.cpp)
target_link_libraries(saccade_gmc_flow PUBLIC saccade_flow_records saccade_tracking_reference saccade_motion saccade_mot_output)
add_executable(gmc_flow_tests tests/gmc_flow_tests.cpp)
target_link_libraries(gmc_flow_tests PRIVATE saccade_gmc_flow)
add_executable(gmc_flow_offline tools/gmc_flow_offline.cpp)
target_link_libraries(gmc_flow_offline PRIVATE saccade_gmc_flow)
add_executable(gmc_records tools/gmc_records.cpp)
target_link_libraries(gmc_records PRIVATE saccade_gmc_flow)
if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
  foreach(target saccade_gmc_flow gmc_flow_tests gmc_flow_offline gmc_records)
    target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Werror -ffp-contract=off)
  endforeach()
endif()
add_test(NAME gmc_flow_controls COMMAND gmc_flow_tests)

if(SACCADE_ENABLE_CUDA)
  add_library(saccade_flow_motion cuda/flow_motion.cu)
  set_target_properties(saccade_flow_motion PROPERTIES CUDA_STANDARD 20 CUDA_STANDARD_REQUIRED ON)
  target_include_directories(saccade_flow_motion PRIVATE third_party/nvof)
  target_link_libraries(saccade_flow_motion PUBLIC saccade_gmc_flow saccade_protocol CUDA::cudart CUDA::cuda_driver ${CMAKE_DL_LIBS})
  target_compile_options(saccade_flow_motion PRIVATE --ftz=false --prec-div=true --prec-sqrt=true --fmad=false -lineinfo)
  add_executable(flow_motion_cuda_tests tests/flow_motion_cuda_tests.cpp)
  target_link_libraries(flow_motion_cuda_tests PRIVATE saccade_flow_motion)
  target_compile_options(flow_motion_cuda_tests PRIVATE -Wall -Wextra -Wpedantic -Werror -ffp-contract=off)
  add_test(NAME flow_motion_cuda COMMAND flow_motion_cuda_tests)
  set_tests_properties(flow_motion_cuda PROPERTIES LABELS "gpu;flow" TIMEOUT 180)
endif()

option(SACCADE_ENABLE_FLOW "Build the experimental API 2.0 NVOF sequence tool" OFF)
if(SACCADE_ENABLE_FLOW)
  if(NOT (SACCADE_ENABLE_CUDA AND SACCADE_ENABLE_PREPROCESS))
    message(FATAL_ERROR "SACCADE_ENABLE_FLOW needs CUDA and PREPROCESS enabled")
  endif()
  add_library(saccade_flow_cuda cuda/flow.cu)
  set_target_properties(saccade_flow_cuda PROPERTIES CUDA_STANDARD 20 CUDA_STANDARD_REQUIRED ON)
  target_include_directories(saccade_flow_cuda PRIVATE third_party/nvof)
  target_link_libraries(saccade_flow_cuda PUBLIC saccade_flow_records CUDA::cudart CUDA::cuda_driver ${CMAKE_DL_LIBS})
  target_compile_options(saccade_flow_cuda PRIVATE --ftz=false --prec-div=true --prec-sqrt=true --fmad=false -lineinfo)
  add_executable(flow_sequence tools/flow_sequence.cpp)
  target_link_libraries(flow_sequence PRIVATE saccade_flow_cuda saccade_preprocess saccade_file_io)
  add_executable(flow_cuda_tests tests/flow_cuda_tests.cpp)
  target_link_libraries(flow_cuda_tests PRIVATE saccade_flow_cuda)
  if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
    foreach(target flow_sequence flow_cuda_tests)
      target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Werror -ffp-contract=off)
    endforeach()
  endif()
  add_test(NAME flow_feasibility COMMAND flow_cuda_tests --f1)
  add_test(NAME flow_synthetic_shift COMMAND flow_cuda_tests --f2)
  set_tests_properties(flow_feasibility flow_synthetic_shift PROPERTIES LABELS "gpu;flow" TIMEOUT 180)
  # Standalone prerequisite audit for TRACKING §20.6; no session dependency.
  add_executable(ofa_audit tools/ofa_audit.cu)
  set_target_properties(ofa_audit PROPERTIES CUDA_STANDARD 20 CUDA_STANDARD_REQUIRED ON)
  target_include_directories(ofa_audit PRIVATE third_party/nvof)
  target_link_libraries(ofa_audit PRIVATE saccade_sha256 CUDA::cudart CUDA::cuda_driver ${CMAKE_DL_LIBS})
  target_compile_options(ofa_audit PRIVATE --ftz=false --prec-div=true --prec-sqrt=true --fmad=false -lineinfo)
  add_test(NAME ofa_stream_audit COMMAND ofa_audit ${CMAKE_CURRENT_BINARY_DIR}/ofa-audit-raw)
  set_tests_properties(ofa_stream_audit PROPERTIES LABELS "gpu;flow" TIMEOUT 180)
endif()

# Experimental optical-flow extraction; independent of F05/F06.
add_library(saccade_flow_records src/flow_records.cpp)
target_include_directories(saccade_flow_records PUBLIC include)
add_executable(flow_records_tests tests/flow_records_tests.cpp)
target_link_libraries(flow_records_tests PRIVATE saccade_flow_records)
if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
  foreach(target saccade_flow_records flow_records_tests)
    target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Werror -ffp-contract=off)
  endforeach()
endif()
add_test(NAME flow_records COMMAND flow_records_tests ${CMAKE_CURRENT_BINARY_DIR}/flow-test.scfl)

option(SACCADE_ENABLE_FLOW "Build the experimental API 2.0 NVOF sequence tool" OFF)
if(SACCADE_ENABLE_FLOW)
  if(NOT (SACCADE_ENABLE_CUDA AND SACCADE_ENABLE_PREPROCESS))
    message(FATAL_ERROR "SACCADE_ENABLE_FLOW needs CUDA and PREPROCESS enabled")
  endif()
  add_library(saccade_flow_cuda cuda/flow.cu)
  set_target_properties(saccade_flow_cuda PROPERTIES CUDA_STANDARD 20 CUDA_STANDARD_REQUIRED ON)
  target_include_directories(saccade_flow_cuda PRIVATE third_party/nvof)
  target_link_libraries(saccade_flow_cuda PUBLIC saccade_flow_records CUDA::cudart CUDA::cuda_driver ${CMAKE_DL_LIBS})
  target_compile_options(saccade_flow_cuda PRIVATE --ftz=false --prec-div=true --prec-sqrt=true --fmad=false -lineinfo)
  add_executable(flow_sequence tools/flow_sequence.cpp)
  target_link_libraries(flow_sequence PRIVATE saccade_flow_cuda saccade_preprocess saccade_file_io)
  add_executable(flow_cuda_tests tests/flow_cuda_tests.cpp)
  target_link_libraries(flow_cuda_tests PRIVATE saccade_flow_cuda)
  if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
    foreach(target flow_sequence flow_cuda_tests)
      target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Werror -ffp-contract=off)
    endforeach()
  endif()
  add_test(NAME flow_feasibility COMMAND flow_cuda_tests --f1)
  add_test(NAME flow_synthetic_shift COMMAND flow_cuda_tests --f2)
  set_tests_properties(flow_feasibility flow_synthetic_shift PROPERTIES LABELS "gpu;flow" TIMEOUT 180)
endif()

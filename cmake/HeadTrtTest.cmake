# S04 head engine lifecycle under CTest (docs/HEAD_TRT.md §6). MODE:
#   build       the bundle (the converted candidate, or synthetic seed 3 without
#               one), then `head_trt build`, recording both SHA-256 values
#   run         a new process: `head_trt run` on the recorded engine and bundle
#   unregistered  deserialize without the plugin creators: no execution context
#   suite       `head_trt_tests` with ARGS (e.g. --group api_trace)
set(engine "${WORK}/head.engine")
set(bundle_file "${WORK}/bundle.path")
if(MODE STREQUAL "build")
  file(MAKE_DIRECTORY "${WORK}")
  if(CANDIDATE_BUNDLE)
    set(bundle "${CANDIDATE_BUNDLE}")
  else()
    set(bundle "${WORK}/synthetic-head.swb")
    execute_process(COMMAND "${WEIGHTS}" synthetic 3 "${bundle}" RESULT_VARIABLE code ERROR_VARIABLE err)
    if(NOT code EQUAL 0)
      message(FATAL_ERROR "synthetic bundle failed: ${err}")
    endif()
  endif()
  file(SHA256 "${bundle}" bundle_sha)
  execute_process(COMMAND "${HEAD_TRT}" build "${bundle}" "${bundle_sha}" "${engine}" "${WORK}/build-report.txt" RESULT_VARIABLE code
    OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "head_trt build failed (${code}): ${out}${err}")
  endif()
  file(WRITE "${bundle_file}" "${bundle}")
  message(STATUS "${out}bundle=${bundle} sha256=${bundle_sha}")
  return()
endif()
file(READ "${bundle_file}" bundle)
file(SHA256 "${bundle}" bundle_sha)
file(SHA256 "${engine}" engine_sha)
if(MODE STREQUAL "run")
  set(command "${HEAD_TRT}" run "${engine}" "${engine_sha}" "${bundle}" "${bundle_sha}" "${WORK}/run-report.txt")
elseif(MODE STREQUAL "unregistered")
  set(command "${HEAD_TRT}" run-unregistered "${engine}")
elseif(MODE STREQUAL "suite")
  separate_arguments(extra UNIX_COMMAND "${ARGS}")
  set(command "${SUITE}" "${engine}" "${engine_sha}" "${bundle}" "${bundle_sha}" ${extra})
else()
  message(FATAL_ERROR "unknown MODE ${MODE}")
endif()
execute_process(COMMAND ${command} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
message(STATUS "${out}")
if(NOT code EQUAL 0)
  message(FATAL_ERROR "${MODE} failed (${code}):\n${err}")
endif()

# CLI parsing, integrity and checked-output behavior. All generated files live
# in a fresh build-local test directory; versioned fixtures are read-only.
if(NOT DEFINED PROGRAM OR NOT EXISTS "${PROGRAM}" OR NOT DEFINED FIXTURE_SOURCE OR NOT DEFINED FIXTURE_DIR)
  message(FATAL_ERROR "PROGRAM, FIXTURE_SOURCE and FIXTURE_DIR are required")
endif()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef run_id)
set(run "${FIXTURE_DIR}/manifest-${run_id}")
file(MAKE_DIRECTORY "${run}" "${run}/cwd" "${run}/directory")
file(COPY "${FIXTURE_SOURCE}/contract.json" "${FIXTURE_SOURCE}/bytes.txt" DESTINATION "${run}")

function(invoke name expected diagnostic)
  execute_process(COMMAND "${PROGRAM}" ${ARGN} WORKING_DIRECTORY "${run}/cwd"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 20)
  file(WRITE "${run}/${name}.stdout.log" "${output}")
  file(WRITE "${run}/${name}.stderr.log" "${error}")
  file(WRITE "${run}/${name}.exit" "${result}\n")
  if(NOT "${result}" STREQUAL "${expected}")
    message(FATAL_ERROR "${name}: expected exit ${expected}, got ${result}: ${output}${error}")
  endif()
  string(FIND "${output}${error}" "${diagnostic}" found)
  if(found EQUAL -1)
    message(FATAL_ERROR "${name}: missing diagnostic ${diagnostic}: ${output}${error}")
  endif()
endfunction()

invoke(validate 0 "artifact_files=not_checked" validate "${run}/contract.json")
invoke(verify 0 "artifact_files=verified" verify "${run}/contract.json" "${run}/canonical.json")
# The complete output is checked, including the explicit readiness boundary.
file(READ "${run}/verify.stdout.log" identity)
set(expected "schema=1\npurpose=test_fixture\nmanifest_declaration=verified\nartifact_files=verified\nmodel_content=not_checked\nreal_model_ready=false\ncanonical_sha256=97d83da29be2693ba86a210a10c8a5454de8a135b5b31985feb3aee07152b0b7\n")
if(NOT identity STREQUAL expected)
  message(FATAL_ERROR "unexpected verification identity: ${identity}")
endif()
file(SHA256 "${run}/canonical.json" canonical_hash)
if(NOT canonical_hash STREQUAL "97d83da29be2693ba86a210a10c8a5454de8a135b5b31985feb3aee07152b0b7")
  message(FATAL_ERROR "independent CMake file(SHA256) canonical mismatch")
endif()
invoke(roundtrip 0 "canonical_sha256=${canonical_hash}" validate "${run}/canonical.json")
invoke(missing_manifest 2 "cannot open input" validate "${run}/missing.json")
invoke(directory_manifest 2 "cannot read input" validate "${run}/directory")
invoke(output_directory 2 "cannot open output" validate "${run}/contract.json" "${run}/directory")
invoke(output_missing_parent 2 "cannot open output" validate "${run}/contract.json" "${run}/missing/out.json")
invoke(output_input_alias 2 "canonical output aliases input manifest" validate "${run}/contract.json" "${run}/contract.json")
invoke(output_artifact_alias 2 "canonical output aliases artifact" validate "${run}/contract.json" "${run}/bytes.txt")
invoke(usage 2 "usage:" wrong "${run}/contract.json")
file(WRITE "${run}/bytes.txt" "abcx")
invoke(size 2 "size_bytes mismatch" verify "${run}/contract.json")
# Declaration validation deliberately does not assert file integrity.
invoke(size_validation_only 0 "artifact_files=not_checked" validate "${run}/contract.json")
file(WRITE "${run}/bytes.txt" "abd")
invoke(hash 2 "SHA-256 mismatch" verify "${run}/contract.json")
file(REMOVE "${run}/bytes.txt")
invoke(missing_artifact 2 "missing or inaccessible file" verify "${run}/contract.json")
file(WRITE "${run}/bytes.txt" "abc")
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" AND EXISTS "/dev/full")
  invoke(canonical_full 2 "cannot write or close output" verify "${run}/contract.json" "/dev/full")
  execute_process(COMMAND "${PROGRAM}" validate "${run}/contract.json"
    RESULT_VARIABLE result OUTPUT_FILE "/dev/full" ERROR_VARIABLE error TIMEOUT 20)
  file(WRITE "${run}/stdout_full.stderr.log" "${error}")
  file(WRITE "${run}/stdout_full.exit" "${result}\n")
  if(NOT "${result}" STREQUAL "2" OR NOT error MATCHES "cannot write standard output")
    message(FATAL_ERROR "stdout write failure was not reported: ${result}: ${error}")
  endif()
  file(CREATE_LINK "${run}/contract.json" "${run}/alias.json" SYMBOLIC RESULT linked)
  if(NOT "${linked}" STREQUAL "0")
    message(FATAL_ERROR "cannot create alias fixture: ${linked}")
  endif()
  invoke(symlink_alias 2 "canonical output aliases input manifest" validate "${run}/contract.json" "${run}/alias.json")
endif()
message(STATUS "manifest CLI checks passed; raw outputs: ${run}")

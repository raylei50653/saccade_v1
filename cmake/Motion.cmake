add_library(saccade_motion src/motion_reference.cpp)
target_include_directories(saccade_motion PUBLIC include)
add_executable(motion_reference_tests tests/motion_reference_tests.cpp)
target_link_libraries(motion_reference_tests PRIVATE saccade_motion)
if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
  foreach(target saccade_motion motion_reference_tests)
    target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Werror -ffp-contract=off)
  endforeach()
endif()
add_test(NAME motion_reference COMMAND motion_reference_tests)

if(SACCADE_ENABLE_CUDA)
  add_library(saccade_motion_cuda cuda/motion.cu)
  set_target_properties(saccade_motion_cuda PROPERTIES CUDA_STANDARD 20 CUDA_STANDARD_REQUIRED ON)
  target_link_libraries(saccade_motion_cuda PUBLIC saccade_motion CUDA::cudart CUDA::cufft)
  target_compile_options(saccade_motion_cuda PRIVATE
    --ftz=false --prec-div=true --prec-sqrt=true --fmad=false -lineinfo)
  add_executable(motion_cuda_tests tests/motion_cuda_tests.cpp)
  target_link_libraries(motion_cuda_tests PRIVATE saccade_motion_cuda)
  if(SACCADE_ENABLE_PREPROCESS)
    target_link_libraries(motion_cuda_tests PRIVATE saccade_preprocess saccade_file_io)
    target_compile_definitions(motion_cuda_tests PRIVATE SACCADE_MOTION_TEST_PREPROCESS=1)
    add_executable(motion_sequence tools/motion_sequence.cpp)
    target_link_libraries(motion_sequence PRIVATE saccade_motion_cuda saccade_preprocess saccade_file_io)
    if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
      target_compile_options(motion_sequence PRIVATE -Wall -Wextra -Wpedantic -Werror -ffp-contract=off)
    endif()
  endif()
  if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
    target_compile_options(motion_cuda_tests PRIVATE -Wall -Wextra -Wpedantic -Werror -ffp-contract=off)
  endif()
  add_test(NAME motion_cuda COMMAND motion_cuda_tests)
  set_tests_properties(motion_cuda PROPERTIES LABELS "gpu" TIMEOUT 300)
endif()

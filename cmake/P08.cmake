# P08 tools are SDK-independent and remain in the formal dependency closure.
add_library(saccade_resolved_config src/resolved_config.cpp)
target_link_libraries(saccade_resolved_config PUBLIC saccade_tracking_core saccade_sha256)
add_library(saccade_tracking_events src/tracking_events.cpp)
target_link_libraries(saccade_tracking_events PUBLIC saccade_tracking_core saccade_sha256)
target_link_libraries(saccade_tracking_reference PUBLIC saccade_tracking_events)
add_executable(tracking_config tools/tracking_config.cpp)
target_link_libraries(tracking_config PRIVATE saccade_resolved_config saccade_file_io)
add_executable(tracking_events tools/tracking_events.cpp)
target_link_libraries(tracking_events PRIVATE saccade_tracking_events saccade_resolved_config saccade_file_io)
add_executable(resolved_config_tests tests/resolved_config_tests.cpp)
target_link_libraries(resolved_config_tests PRIVATE saccade_resolved_config)
add_executable(tracking_events_tests tests/tracking_events_tests.cpp)
target_link_libraries(tracking_events_tests PRIVATE saccade_tracking_events saccade_tracking_reference)
execute_process(COMMAND git rev-parse HEAD WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}
  OUTPUT_VARIABLE SACCADE_P08_COMMIT OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND git status --porcelain WORKING_DIRECTORY ${CMAKE_CURRENT_SOURCE_DIR}
  OUTPUT_VARIABLE SACCADE_P08_STATUS OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
if(SACCADE_P08_STATUS STREQUAL "")
  set(SACCADE_P08_DIRTY "false")
else()
  set(SACCADE_P08_DIRTY "true")
endif()
foreach(target tracking_config tracking_events)
  target_compile_definitions(${target} PRIVATE SACCADE_BUILD_COMMIT="${SACCADE_P08_COMMIT}"
    SACCADE_BUILD_DIRTY="${SACCADE_P08_DIRTY}")
endforeach()
if(SACCADE_ENABLE_DETECTION_SESSION)
  target_compile_definitions(tracking_config PRIVATE SACCADE_P08_HAS_CUDA=1)
endif()
if(SACCADE_ENABLE_STREAMING)
  target_compile_definitions(tracking_config PRIVATE SACCADE_P08_HAS_STREAMING=1)
endif()
if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
  foreach(target saccade_resolved_config saccade_tracking_events tracking_config tracking_events
      resolved_config_tests tracking_events_tests)
    target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Werror -ffp-contract=off)
  endforeach()
endif()
add_test(NAME tracking_resolved_config COMMAND resolved_config_tests)
add_test(NAME tracking_behavior_events COMMAND tracking_events_tests)
find_package(Python3 COMPONENTS Interpreter QUIET)
if(Python3_Interpreter_FOUND)
  add_test(NAME tracking_p08_cli COMMAND "${Python3_EXECUTABLE}"
    "${CMAKE_CURRENT_SOURCE_DIR}/tests/p08_cli_tests.py" --bin-dir "${CMAKE_CURRENT_BINARY_DIR}")
  set_tests_properties(tracking_p08_cli PROPERTIES TIMEOUT 120)
endif()

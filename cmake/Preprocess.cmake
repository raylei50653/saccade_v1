if(NOT TARGET CUDA::nvjpeg)
  message(FATAL_ERROR "Native preprocessing requires the CUDA Toolkit nvJPEG library")
endif()

add_library(saccade_resize_cuda cuda/resize.cu)
set_target_properties(saccade_resize_cuda PROPERTIES CUDA_STANDARD 20 CUDA_STANDARD_REQUIRED ON)
target_include_directories(saccade_resize_cuda PUBLIC include)
target_link_libraries(saccade_resize_cuda PUBLIC CUDA::cudart)
target_compile_options(saccade_resize_cuda PRIVATE --ftz=false --prec-div=true --prec-sqrt=true --fmad=true -lineinfo)
target_compile_definitions(saccade_resize_cuda PRIVATE
  SACCADE_BUILD_COMMIT="${SACCADE_BUILD_COMMIT}" SACCADE_BUILD_DIRTY="${SACCADE_BUILD_DIRTY}")

add_library(saccade_preprocess src/preprocess.cpp)
target_link_libraries(saccade_preprocess PUBLIC saccade_resize_cuda CUDA::nvjpeg saccade_sha256)
target_compile_definitions(saccade_preprocess PRIVATE
  SACCADE_BUILD_COMMIT="${SACCADE_BUILD_COMMIT}" SACCADE_BUILD_DIRTY="${SACCADE_BUILD_DIRTY}")
add_executable(preprocess tools/preprocess.cpp)
target_link_libraries(preprocess PRIVATE saccade_preprocess saccade_file_io saccade_sha256)
add_executable(resize_cuda_tests tests/resize_cuda_tests.cpp)
target_link_libraries(resize_cuda_tests PRIVATE saccade_resize_cuda)
add_executable(preprocess_tests tests/preprocess_tests.cpp)
target_link_libraries(preprocess_tests PRIVATE saccade_preprocess saccade_file_io)
if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
  foreach(target saccade_preprocess preprocess resize_cuda_tests preprocess_tests)
    target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -Werror -ffp-contract=off)
  endforeach()
endif()
add_test(NAME resize_cuda COMMAND resize_cuda_tests)
add_test(NAME native_preprocess COMMAND preprocess_tests ${CMAKE_CURRENT_SOURCE_DIR}/fixtures/preprocess)
set_tests_properties(resize_cuda native_preprocess PROPERTIES LABELS "gpu;preprocess" TIMEOUT 180)
set(SACCADE_PREPROCESS_REFERENCES "" CACHE PATH "Offline t01_preprocess_ref.py references (optional)")
if(SACCADE_PREPROCESS_REFERENCES)
  add_test(NAME preprocess_reference COMMAND preprocess run ${SACCADE_PREPROCESS_REFERENCES}
    ${CMAKE_CURRENT_BINARY_DIR}/preprocess-reference)
  set_tests_properties(preprocess_reference PROPERTIES LABELS "gpu;preprocess" TIMEOUT 300)
endif()

if(NOT DEFINED PROGRAM OR NOT DEFINED FIXTURE_DIR)
  message(FATAL_ERROR "PROGRAM and FIXTURE_DIR are required")
endif()
file(MAKE_DIRECTORY "${FIXTURE_DIR}")
execute_process(COMMAND "${PROGRAM}" "${FIXTURE_DIR}/alias" "${FIXTURE_DIR}/alias"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "engine and report paths must differ")
  message(FATAL_ERROR "engine/report alias not rejected: ${result} ${output} ${error}")
endif()
execute_process(COMMAND "${PROGRAM}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "usage:")
  message(FATAL_ERROR "CLI usage failure not detected: ${result} ${output} ${error}")
endif()
execute_process(COMMAND "${PROGRAM}" "${FIXTURE_DIR}/absent/engine" "${FIXTURE_DIR}/report"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "cannot open output")
  message(FATAL_ERROR "engine output failure not detected: ${result} ${output} ${error}")
endif()
if(EXISTS "/dev/full")
  execute_process(COMMAND "${PROGRAM}" /dev/full "${FIXTURE_DIR}/report"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(result EQUAL 0 OR NOT error MATCHES "cannot write or close output")
    message(FATAL_ERROR "engine write/close failure not detected: ${result} ${output} ${error}")
  endif()
  execute_process(COMMAND "${PROGRAM}" "${FIXTURE_DIR}/engine" /dev/full
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(result EQUAL 0 OR NOT error MATCHES "cannot write or close output")
    message(FATAL_ERROR "report write/close failure not detected: ${result} ${output} ${error}")
  endif()
  execute_process(COMMAND "${PROGRAM}" "${FIXTURE_DIR}/engine" "${FIXTURE_DIR}/report"
    RESULT_VARIABLE result OUTPUT_FILE /dev/full ERROR_VARIABLE error)
  if(result EQUAL 0 OR NOT error MATCHES "cannot write stdout")
    message(FATAL_ERROR "stdout failure not detected: ${result} ${error}")
  endif()
endif()
message(STATUS "native TensorRT CLI checked I/O failures: PASS")

+        << "\nint8=" << (config.getFlag(BuilderFlag::kINT8) ? "on" : "off")
+        << "\nbuilder_flags_readback=" << config.getFlags()
+        << "\nscan_plugin_precision=fp32\nmodel_io_precision=fp32\n"
+           "fp32_tactic_policy=not_applicable_experimental_mixed_precision\n";
+}
+#pragma GCC diagnostic pop

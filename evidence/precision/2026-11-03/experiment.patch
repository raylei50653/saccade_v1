+// Isolated experiment only. The default and explicit fp32 preserve the
+// original strongly typed build, including its FP32 tactic policy.
+enum class ExperimentPrecision { FP32, FP16, BF16 };
+
+ExperimentPrecision experiment_precision() {
+    const char* value = std::getenv("SACCADE_EXPERIMENT_PRECISION");
+    if (value == nullptr || std::string(value) == "fp32") return ExperimentPrecision::FP32;
+    if (std::string(value) == "fp16") return ExperimentPrecision::FP16;
+    if (std::string(value) == "bf16") return ExperimentPrecision::BF16;
+    throw std::invalid_argument("SACCADE_EXPERIMENT_PRECISION must be fp32, fp16 or bf16");
+}
+
+// TensorRT 10.16 keeps these deprecated flags for weakly typed networks.
+// Limit warning suppression to the API compatibility boundary.
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wdeprecated-declarations"
+void allow_experiment_precision(IBuilderConfig& config, ExperimentPrecision precision) {
+    config.clearFlag(BuilderFlag::kFP16);
+    config.clearFlag(BuilderFlag::kBF16);
+    if (precision == ExperimentPrecision::FP16) config.setFlag(BuilderFlag::kFP16);
+    if (precision == ExperimentPrecision::BF16) config.setFlag(BuilderFlag::kBF16);
+}
+
+int experiment_optimization_level(ExperimentPrecision precision) {
+    const char* value = std::getenv("SACCADE_EXPERIMENT_OPT_LEVEL");
+    if (precision == ExperimentPrecision::FP32 || value == nullptr) return kHeadBuilderOptimizationLevel;
+    return std::stoi(value);
+}
+
+void preserve_experiment_output_type(ITensor& tensor) {
+    tensor.setType(DataType::kFLOAT);
+}
+
+void report_experiment_precision(std::ostream& out, const IBuilderConfig& config, ExperimentPrecision precision) {

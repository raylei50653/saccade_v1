diff --git a/tools/precision_probe.cpp b/tools/precision_probe.cpp
new file mode 100644
index 0000000..03eb884
--- /dev/null
+++ b/tools/precision_probe.cpp
@@ -0,0 +1,212 @@
+// Disposable experiment: complete-model output dumps and device-only timing.
+// Not a numerical acceptance gate. No JPEG/preprocess/decode/NMS in timings.
+#include "saccade/file_io.hpp"
+#include "saccade/model_trt_network.hpp"
+#include "saccade/scan_trt_frame.hpp"
+#include "saccade/scan_trt_plugin.hpp"
+#include "saccade/sha256.hpp"
+
+#include <NvInfer.h>
+#include <cuda_runtime_api.h>
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <cstring>
+#include <filesystem>
+#include <iomanip>
+#include <iostream>
+#include <numeric>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace {
+using namespace saccade;
+class Logger final : public nvinfer1::ILogger {
+public:
+    std::atomic<unsigned> errors{0};
+    void log(Severity severity, const char* message) noexcept override {
+        if (severity <= Severity::kERROR) ++errors;
+        if (severity <= Severity::kWARNING) std::cerr << "TensorRT: " << message << '\n';
+    }
+};
+void require(bool condition, const std::string& message) {
+    if (!condition) throw std::runtime_error(message);
+}
+void checked(cudaError_t error, const char* what) {
+    if (error != cudaSuccess) throw std::runtime_error(std::string(what) + ": " + cudaGetErrorString(error));
+}
+std::span<const std::uint8_t> bytes(const std::string& text) {
+    return {reinterpret_cast<const std::uint8_t*>(text.data()), text.size()};
+}
+std::size_t elements(const std::vector<std::int64_t>& shape) {
+    std::size_t count = 1;
+    for (const auto dimension : shape) count *= static_cast<std::size_t>(dimension);
+    return count;
+}
+std::string pack(const ScanFrameSession& session, const std::vector<float>& arena) {
+    std::string result;
+    for (const auto& output : session.outputs()) {
+        const auto data = std::span<const float>(arena).subspan(output.offset, output.count);
+        require(std::all_of(data.begin(), data.end(), [](float x) { return std::isfinite(x); }), "nonfinite raw output");
+        result.append(reinterpret_cast<const char*>(data.data()), data.size_bytes());
+    }
+    return result;
+}
+void accepted(const ScanFrameRun& run) {
+    require(run.published == std::vector<std::int64_t>{0} && run.committed_payload_frame == 0,
+            "frame rejected by plugin statuses or finite checks");
+}
+struct Events {
+    std::vector<cudaEvent_t> starts, ends;
+    explicit Events(int count) : starts(static_cast<std::size_t>(count)), ends(static_cast<std::size_t>(count)) {
+        for (auto& event : starts) checked(cudaEventCreate(&event), "cudaEventCreate start");
+        for (auto& event : ends) checked(cudaEventCreate(&event), "cudaEventCreate end");
+    }
+    ~Events() {
+        for (const auto event : starts) if (event) cudaEventDestroy(event);
+        for (const auto event : ends) if (event) cudaEventDestroy(event);
+    }
+};
+struct Graph {
+    cudaGraph_t graph = nullptr;
+    cudaGraphExec_t executable = nullptr;
+    ~Graph() {
+        if (executable) cudaGraphExecDestroy(executable);
+        if (graph) cudaGraphDestroy(graph);
+    }
+};
+template <typename Launch>
+std::vector<float> measure(cudaStream_t stream, int warmup, int iterations, Launch launch) {
+    Events events(iterations);
+    for (int i = 0; i < warmup; ++i) launch();
+    checked(cudaStreamSynchronize(stream), "warmup synchronize");
+    for (int i = 0; i < iterations; ++i) {
+        const auto k = static_cast<std::size_t>(i);
+        checked(cudaEventRecord(events.starts[k], stream), "record start");
+        launch();
+        checked(cudaEventRecord(events.ends[k], stream), "record end");
+    }
+    checked(cudaStreamSynchronize(stream), "timing synchronize");
+    std::vector<float> result(static_cast<std::size_t>(iterations));
+    for (std::size_t i = 0; i < result.size(); ++i)
+        checked(cudaEventElapsedTime(&result[i], events.starts[i], events.ends[i]), "event elapsed time");
+    return result;
+}
+void statistics(const char* name, const std::vector<float>& values) {
+    auto sorted = values;
+    std::sort(sorted.begin(), sorted.end());
+    const double mean = std::accumulate(values.begin(), values.end(), 0.0) / static_cast<double>(values.size());
+    const auto percentile = [&](double p) { return sorted[static_cast<std::size_t>(std::ceil(p * static_cast<double>(sorted.size()))) - 1]; };
+    std::cout << "\"" << name << "\":{\"mean_ms\":" << mean << ",\"median_ms\":" << percentile(0.5)
+              << ",\"p95_ms\":" << percentile(0.95) << ",\"min_ms\":" << sorted.front()
+              << ",\"max_ms\":" << sorted.back() << ",\"samples_ms\":[";
+    for (std::size_t i = 0; i < values.size(); ++i) std::cout << (i ? "," : "") << values[i];
+    std::cout << "]}";
+}
+void validate_device_result(ScanFrameSession& session, const FrameIoSpec& spec) {
+    const auto slot = session.slot(0);
+    for (std::size_t i = 0; i < spec.statuses.size(); ++i) {
+        ScanStatus status{};
+        checked(cudaMemcpy(&status, slot.statuses[i], sizeof(status), cudaMemcpyDeviceToHost), "status readback");
+        require(status.flags == 0 && status.done == kScanDone, "bad plugin status after benchmark: " + spec.statuses[i].name);
+    }
+    for (std::size_t i = 0; i < session.outputs().size(); ++i) {
+        std::vector<float> output(session.outputs()[i].count);
+        checked(cudaMemcpy(output.data(), slot.outputs[i], output.size() * sizeof(float), cudaMemcpyDeviceToHost), "output readback");
+        require(std::all_of(output.begin(), output.end(), [](float x) { return std::isfinite(x); }), "nonfinite output after benchmark");
+    }
+}
+} // namespace
+
+int main(int argc, char** argv) {
+    try {
+        require(argc == 5 || argc == 7, "usage: precision_probe ENGINE INPUTS DUMP_DIR PROFILE [WARMUP ITERATIONS]");
+        const int warmup = argc == 7 ? std::stoi(argv[5]) : 100;
+        const int iterations = argc == 7 ? std::stoi(argv[6]) : 500;
+        require(warmup >= 1 && iterations >= 1, "warmup and iterations must be positive");
+        const auto profile = parse_model_profile(argv[4]);
+        const auto spec = model_io_spec(profile);
+        const auto plan = read_text_file(argv[1]);
+        const auto images = read_text_file(argv[2]);
+        const auto frame_elements = elements(model_input_shape(profile));
+        const auto frame_bytes = frame_elements * sizeof(float);
+        require(!images.empty() && images.size() % frame_bytes == 0, "input file is not a whole number of selected-profile FP32 frames");
+        const auto frames = images.size() / frame_bytes;
+        require(frames <= 32, "probe accepts at most 32 reference frames");
+        std::filesystem::create_directories(argv[3]);
+        Logger logger;
+        register_scan_trt_plugins(*getPluginRegistry());
+        std::vector<std::vector<float>> inputs(frames, std::vector<float>(frame_elements));
+        for (std::size_t i = 0; i < frames; ++i) std::memcpy(inputs[i].data(), images.data() + i * frame_bytes, frame_bytes);
+        std::vector<std::string> committed;
+        std::vector<float> enqueue_times, graph_times;
+        {
+            ScanFrameConfig config;
+            config.slots = 1;
+            ScanFrameSession session(bytes(plan), config, logger, nullptr, &spec);
+            for (std::size_t i = 0; i < frames; ++i) {
+                const auto result = session.run({{inputs[i]}});
+                accepted(result);
+                committed.push_back(pack(session, result.committed_payload));
+                const auto again = session.run({{inputs[i]}});
+                accepted(again);
+                require(pack(session, again.committed_payload) == committed.back(), "nondeterministic rerun");
+                write_binary_file(std::filesystem::path(argv[3]) / ("input-" + std::to_string(i) + ".f32"), bytes(committed.back()));
+            }
+            // Fix timing input to frame 0; H2D and harness are outside all events.
+            const auto resident = session.run({{inputs[0]}});
+            accepted(resident);
+            const auto stream = session.detect_stream();
+            auto& context = session.context(0);
+            const auto launch = [&] { require(context.enqueueV3(stream), "enqueueV3 failed"); };
+            enqueue_times = measure(stream, warmup, iterations, launch);
+            validate_device_result(session, spec);
+            Graph graph;
+            checked(cudaStreamBeginCapture(stream, cudaStreamCaptureModeGlobal), "begin graph capture");
+            launch();
+            checked(cudaStreamEndCapture(stream, &graph.graph), "end graph capture");
+            checked(cudaGraphInstantiate(&graph.executable, graph.graph, 0), "instantiate graph");
+            graph_times = measure(stream, warmup, iterations, [&] { checked(cudaGraphLaunch(graph.executable, stream), "graph launch"); });
+            validate_device_result(session, spec);
+            session.close();
+        }
+        {
+            ScanFrameConfig config;
+            config.slots = 1;
+            config.graphs = true;
+            ScanFrameSession session(bytes(plan), config, logger, nullptr, &spec);
+            for (std::size_t i = 0; i < frames; ++i) {
+                const auto result = session.run({{inputs[i]}});
+                accepted(result);
+                require(pack(session, result.committed_payload) == committed[i], "CUDA graph replay differs from enqueueV3");
+            }
+            session.close();
+        }
+        require(logger.errors == 0, "TensorRT reported errors");
+        int device = 0, runtime = 0, driver = 0;
+        cudaDeviceProp gpu{};
+        checked(cudaGetDevice(&device), "get device");
+        checked(cudaGetDeviceProperties(&gpu, device), "get GPU properties");
+        checked(cudaRuntimeGetVersion(&runtime), "get runtime version");
+        checked(cudaDriverGetVersion(&driver), "get driver version");
+        std::cout << std::setprecision(9) << "{\"schema\":\"saccade-precision-probe/1\",\"profile\":\"" << model_profile(profile).name
+                  << "\",\"engine_sha256\":\"" << sha256_hex(plan) << "\",\"inputs_sha256\":\"" << sha256_hex(images)
+                  << "\",\"gpu\":\"" << gpu.name << "\",\"sm\":\"" << gpu.major << '.' << gpu.minor
+                  << "\",\"cuda_runtime\":" << runtime << ",\"cuda_driver\":" << driver
+                  << ",\"frames\":" << frames << ",\"warmup\":" << warmup << ",\"iterations\":" << iterations
+                  << ",\"finite\":true,\"plugin_statuses\":\"PASS\",\"determinism\":\"bit_identical\",\"graph_parity\":\"bit_identical\","
+                     "\"timing_scope\":\"GPU complete-model batch1; resident frame0; no H2D/D2H, harness, preprocess, decode or NMS\",";
+        statistics("enqueue", enqueue_times);
+        std::cout << ',';
+        statistics("cuda_graph", graph_times);
+        std::cout << ",\"output_sha256\":[";
+        for (std::size_t i = 0; i < committed.size(); ++i) std::cout << (i ? "," : "") << '"' << sha256_hex(committed[i]) << '"';
+        std::cout << "]}\n";
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << "precision_probe: " << error.what() << '\n';
+        return 1;
+    }
+}

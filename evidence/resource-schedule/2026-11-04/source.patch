+        std::sort(ordered_ids.begin(), ordered_ids.end());
+        std::vector<DetectionCandidate> sorted_pool;
+        constexpr unsigned flags[]{kDetectionKept, kDetectionSuppressed, kDetectionKept | kDetectionSuppressed, 0};

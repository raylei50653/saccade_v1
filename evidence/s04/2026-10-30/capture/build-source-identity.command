bash -c $'\n  set -euo pipefail\n  rev=$1; shift\n  for report in "$@"; do\n    grep -Eq "(^|[[:space:]])build_commit=$rev$" "$report"\n    grep -Eq "(^|[[:space:]])build_dirty=false$" "$report"\n    if grep -q "build_dirty=true" "$report"; then exit 1; fi\n    echo "$report: tested commit and build_dirty=false verified"\n  done\n' _ 3857e243e8fc32663aa688f073343002ad12cb30 /home/ray/developer/ai/saccade_v1/build-s04-evidence4/capture/head-build-report.txt /home/ray/developer/ai/saccade_v1/build-s04-evidence4/capture/head-run-report.txt /home/ray/developer/ai/saccade_v1/build-s04-evidence4/capture/head-suite-report.tsv /home/ray/developer/ai/saccade_v1/build-s04-evidence4/capture/scan-trt-report.tsv 

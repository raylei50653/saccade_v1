bash -c $'\n    log=$1; success_pattern=$2; shift 2; code=0\n    "$@" > "$log" 2>&1 || code=$?\n    cat "$log"\n    reported=$(sed -n "s/^========= ERROR SUMMARY: \\([0-9]*\\) error.*/\\1/p" "$log")\n    notes=$(grep -c "^========= CUDA API Warning: Selective device code recompilation in progress\\.$" "$log" || true)\n    passed=$(grep -Ec "$success_pattern" "$log" || true)\n    unexpected=$(grep -E "^========= [^ ]" "$log" | grep -Ev "^========= (COMPUTE-SANITIZER|CUDA API Warning: Selective device code recompilation in progress\\.|ERROR SUMMARY: [0-9]+ errors?)$" || true)\n    echo "tool exit=$code reported=$reported recompilation_notes=$notes suite_passed=$passed"\n    [[ -z $unexpected ]] || { printf "unexpected sanitizer headers:\\n%s\\n" "$unexpected"; exit 1; }\n    [[ $passed == 1 && ( ( $code == 0 && $reported == 0 && $notes == 0 ) || ( $code == 99 && $notes -gt 0 && $reported == "$notes" ) ) ]]\n  ' _ /home/ray/developer/ai/saccade_v1/build-s04-evidence4/capture/sanitizer-head-memcheck-default-raw.log \^head_trt_tests:\ \[1-9\]\[0-9\]\*\ checks\ passed\$ /opt/cuda/bin/compute-sanitizer --tool memcheck --error-exitcode 99 /home/ray/developer/ai/saccade_v1/build-s04-evidence4/trt/head_trt_tests /home/ray/developer/ai/saccade_v1/build-s04-evidence4/trt/head-trt/head.engine ca74a50d04980b7b15ffd66a968e4851459c4fb8c3fa2db0724d9d55f69509c1 /home/ray/developer/ai/saccade_v1/build-s04-evidence4/stage/t1-head.swb e1a8660fb9ad510f20ccc3d56a4feac61c6a2e5f771aab531caa741e7677f310 --skip intermediates 
